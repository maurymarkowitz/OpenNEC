CM Example 3 :	Inverted-V over ground
CM 		See GetStarted.txt
CE 
SY hgh=20
SY len=20
SY ang=110
SY z=len*cos(ang/2), x=len*sin(ang/2)
'
GW 1 20 -X 0 hgh-Z -0.1 0 hgh #12
GW 2 1 -0.1 0 hgh 0.1 0 hgh #12
GW 3 20 0.1 0 hgh X 0 hgh-z #12
GE
'
'GN -1
'GN 0 0 0 0 14 0.006
GN 2 0 0 0 14 0.006
'
EX 0 2 50% 0 1 0
FR 0 1 0 0 3.68
'
EN
