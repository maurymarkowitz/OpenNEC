CM 20m Sterba curtain
CM
CM corner fed Sterba curtain
CM
CE
SY s=10.43 ! nominal 1/2 wavelength at 14.080 MHz
! nominal 1/2 wavelength at 14.080 MHz
SY q=s*0.5
SY z0=5 ! height of lower elements
! height of lower elements
SY z1=z0+s ! height of upper elements ;
! height of upper elements ;
SY y=0
SY offset0=-0.015
SY offset1=0.015
! feed end
SY feed=z0+2in
! feedpoint at corner of curtain
GW 1,3,offset0,0,z0,offset0,0,feed,awg12
GW 2,15,offset0,0,feed,offset1,0,z1,awg12
! sterba sections
GW 3,21,offset0,y,z0,offset1,y+q,z0,awg12
GW 4,21,offset1,y,z1,offset0,y+q,z1,awg12
GW 5,21,offset1,y+q,z0,offset1,y+q,z1,awg12
GW 6,21,offset0,y+q,z1,offset0,y+q,z0,awg12
SY y=y+q
GW 7,21,offset1,y,z1,offset0,y+q,z1,awg12
GW 8,21,offset0,y,z0,offset1,y+q,z0,awg12
SY y=y+q
SY offset0=-offset0
SY offset1=-offset1
! far end
GW 9,21,offset0,y,z0,offset1,y,z1,awg12
! reflectors sections
SY r=-3.4
SY y=0
GW 10,15,offset0+r,0,z0,offset1+r,0,z1,awg12
GW 11,21,offset0+r,y,z0,offset1+r,y+q,z0,awg12
GW 12,21,offset1+r,y,z1,offset0+r,y+q,z1,awg12
GW 13,21,offset1+r,y+q,z0,offset1+r,y+q,z1,awg12
GW 14,21,offset0+r,y+q,z1,offset0+r,y+q,z0,awg12
SY y=y+q
GW 15,21,offset1+r,y,z1,offset0+r,y+q,z1,awg12
GW 16,21,offset0+r,y,z0,offset1+r,y+q,z0,awg12
SY y=y+q
SY offset0=-offset0
SY offset1=-offset1
! far end
GW 17,21,offset0+r,y,z0,offset1+r,y,z1,awg12
GE 0
EX 0,1,2,0,1,0
GN -1
FR 0,1,0,0,14,0
RP 0,37,73,1000,0,0,5,5
EN
